# Copy to ~/.openclaw/.env (or $OPENCLAW_STATE_DIR/.env). Do not commit.
# Loaded at gateway startup. Used for models, channels, gateway auth, TTS, etc.

# Gateway (generate: openssl rand -hex 32)
OPENCLAW_GATEWAY_TOKEN=

# Models
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# ANTHROPIC_OAUTH_TOKEN=
GEMINI_API_KEY=

# Channels
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# TTS / tools
ELEVENLABS_API_KEY=
BRAVE_API_KEY=

# Add others per integration (Notion, Obsidian, Gmail OAuth dir, etc.)
